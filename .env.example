# Site Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Maps API (client-side: map rendering + dealer finder search autocomplete)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# Note: dealer geocoding in the Payload admin uses Nominatim (OpenStreetMap) — no API key needed

# Payload Configuration
PAYLOAD_SECRET=your-secret-key-here-make-it-long-and-secure-32chars-minimum
DATABASE_URI=mongodb+srv://username:password@your-cluster.mongodb.net/your-database

# On-Demand Revalidation Secret
# Used by Payload CMS hooks to trigger Next.js page revalidation when content changes
# IMPORTANT: Generate a secure random string for production (min 32 characters)
REVALIDATION_SECRET=your-revalidation-secret-here-make-it-secure-32chars-minimum

# Shareable Preview Link Secret
# Used by the "Copy Share Link" button on Posts to generate URLs that let
# non-admin reviewers view unpublished drafts via /api/preview without logging in.
# Rotate this value to invalidate all outstanding share links.
PREVIEW_SECRET=your-preview-secret-here-make-it-secure-32chars-minimum

# Cloudflare R2 Storage Configuration
S3_ACCESS_KEY_ID=your-r2-access-key-id
S3_SECRET_ACCESS_KEY=your-r2-secret-access-key
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_BUCKET=kawaicms
S3_REGION=auto
NEXT_PUBLIC_S3_PUBLIC_URL=https://pub-your-account-id.r2.dev
PAYLOAD_SEED=true

# Migration API Configuration
MIGRATION_API_KEY=kawai-migration-secure-2024-key-change-in-production

# Constant Contact API Configuration (Optional - Currently Disabled)
# Contact forms now use Shopify Admin API for customer management
# Get these from your Constant Contact app at https://app.constantcontact.com/apps
CONSTANT_CONTACT_CLIENT_ID=your-client-id-here
CONSTANT_CONTACT_CLIENT_SECRET=your-client-secret-here
CONSTANT_CONTACT_REFRESH_TOKEN=your-refresh-token-here
CONSTANT_CONTACT_DEFAULT_LIST_ID=1

# Resend Email API Configuration
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
# Verified Resend sender — used by Payload's email adapter, warranty
# notifications, and RSM lead notifications
RESEND_FROM_EMAIL=noreply@kawaius.com
# Inbox for signup leads that can't be matched to an RSM (no geocode result or
# no nearby dealer with an rsmEmail). Also BCC'd on every matched RSM email.
# Defaults to RESEND_FROM_EMAIL when unset.
LEAD_NOTIFY_FALLBACK_EMAIL=
# Lead notification delivery switches. BOTH default OFF — with them off the
# routing pipeline runs end to end and logs the exact To/Bcc a live send would
# have used, without emailing anyone real. Exercise the flow first at
# /zipcodetest2026kawaiamerica, which sends only to your own test inboxes.
#   RSM    -> the standard notification (lead + 5 nearest + the dealer chosen)
#   DEALER -> a warmer, narrower note to the dealer the visitor picked, RSM BCC'd
LEAD_NOTIFY_RSM_EMAIL=false
LEAD_NOTIFY_DEALER_EMAIL=false

# Google Analytics Configuration
NEXT_PUBLIC_GA_ID=G-HM9N0JS9H8

# Meta Pixel Configuration
NEXT_PUBLIC_META_PIXEL_ID=your-meta-pixel-id-here

# Shopify Storefront API Configuration (Public - Safe for Client-Side)
# Used for product browsing, cart, and checkout functionality
# IMPORTANT: These require NEXT_PUBLIC_ prefix for client-side access
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-access-token-here

# Shopify Admin API Configuration (Private - Server-Side Only)
# Used for customer management via OAuth Client Credentials Grant
# CRITICAL: NEVER use NEXT_PUBLIC_ prefix for these credentials
# Get these from: Shopify Dev Dashboard > Your App > API credentials
# Required scopes: write_customers, read_customers
SHOPIFY_APP_API_KEY=your-app-client-id-here
SHOPIFY_APP_CLIENT_SECRET=shpss_your-client-secret-here
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_API_VERSION=2025-10

# Feature Flags
# Show Products menu in header (Shopify integration) - set to 'true' for development, 'false' for production
NEXT_PUBLIC_SHOW_PRODUCTS_MENU=true
# Show migrated pages (Technology, Company, Institutions, Glossary) in Resources nav
# Omit this variable entirely to keep hidden. Set to 'true' to enable for April 1st launch.
# NEXT_PUBLIC_MIGRATION_NAV=true
