'use client'

import React, { useState, useCallback } from 'react'
import { motion, AnimatePresence } from 'framer-motion'
import { cn } from '@/lib/utils'
import { useForm } from 'react-hook-form'
import { zodResolver } from '@hookform/resolvers/zod'

import type { 
  PianoRecommendation,
  ContactInformation
} from '../types'

import { emailCaptureSchema, type EmailCaptureData } from '../lib/validation'

interface EmailCaptureProps {
  title?: string
  description?: string
  benefits?: string[]
  primaryPiano?: PianoRecommendation
  incentive?: {
    title: string
    description: string
    value?: string
  }
  placeholder?: {
    email?: string
    firstName?: string
  }
  onSubmit: (data: EmailCaptureData & { source: string }) => void
  onSuccess?: () => void
  onError?: (error: string) => void
  isSubmitting?: boolean
  variant?: 'default' | 'modal' | 'inline' | 'floating'
  showBenefits?: boolean
  showInterests?: boolean
  className?: string
}

/**
 * Sophisticated Email Capture Component
 * Optimized for luxury piano lead generation with benefit-focused messaging
 */
export const EmailCapture: React.FC<EmailCaptureProps> = ({
  title = "Send My Curated Selection",
  description = "Receive personalized piano recommendations with exclusive pricing and expert insights delivered to your inbox.",
  benefits = [
    "Detailed specifications and comparisons",
    "Exclusive pricing and financing options",
    "High-resolution photos and videos",
    "Expert consultation scheduling"
  ],
  primaryPiano,
  incentive,
  placeholder = {
    email: "your@email.com",
    firstName: "Your first name"
  },
  onSubmit,
  onSuccess,
  onError,
  isSubmitting = false,
  variant = 'default',
  showBenefits = true,
  showInterests = false,
  className
}) => {
  const [step, setStep] = useState<'form' | 'success' | 'error'>('form')
  const [submissionMessage, setSubmissionMessage] = useState<string>('')

  const { register, handleSubmit, formState: { errors }, watch, setValue } = useForm<EmailCaptureData>({
    resolver: zodResolver(emailCaptureSchema),
    defaultValues: {
      optInMarketing: true,
      interests: [],
      urgency: 'exploring'
    }
  })

  const watchedInterests = watch('interests') || []

  const handleFormSubmit = useCallback(async (data: EmailCaptureData) => {
    try {
      await onSubmit({
        ...data,
        source: 'signature-email-capture'
      })
      
      setStep('success')
      setSubmissionMessage("Thank you! Your curated piano selection is on its way to your inbox.")
      onSuccess?.()
    } catch (error) {
      const errorMessage = error instanceof Error ? error.message : 'Something went wrong. Please try again.'
      setStep('error')
      setSubmissionMessage(errorMessage)
      onError?.(errorMessage)
    }
  }, [onSubmit, onSuccess, onError])

  const toggleInterest = useCallback((interest: string) => {
    const currentInterests = watchedInterests || []
    const newInterests = currentInterests.includes(interest)
      ? currentInterests.filter(i => i !== interest)
      : [...currentInterests, interest]
    
    setValue('interests', newInterests)
  }, [watchedInterests, setValue])

  const containerClasses = cn(
    "bg-white rounded-2xl shadow-xl border border-gray-100",
    {
      'p-8': variant === 'default',
      'p-6': variant === 'modal' || variant === 'inline',
      'p-4': variant === 'floating',
      'max-w-md': variant === 'floating',
      'max-w-lg': variant === 'modal',
      'max-w-2xl': variant === 'default' || variant === 'inline'
    },
    className
  )

  return (
    <div className={containerClasses}>
      <AnimatePresence mode="wait">
        {step === 'form' && (
          <EmailCaptureForm
            key="form"
            title={title}
            description={description}
            benefits={showBenefits ? benefits : []}
            primaryPiano={primaryPiano}
            incentive={incentive}
            placeholder={placeholder}
            register={register}
            handleSubmit={handleSubmit}
            errors={errors}
            interests={watchedInterests}
            onToggleInterest={toggleInterest}
            onSubmit={handleFormSubmit}
            isSubmitting={isSubmitting}
            showInterests={showInterests}
            variant={variant}
          />
        )}

        {step === 'success' && (
          <SuccessState
            key="success"
            message={submissionMessage}
            variant={variant}
          />
        )}

        {step === 'error' && (
          <ErrorState
            key="error"
            message={submissionMessage}
            onRetry={() => setStep('form')}
            variant={variant}
          />
        )}
      </AnimatePresence>
    </div>
  )
}

/**
 * Email Capture Form Component
 */
const EmailCaptureForm: React.FC<{
  title: string
  description: string
  benefits: string[]
  primaryPiano?: PianoRecommendation
  incentive?: { title: string; description: string; value?: string }
  placeholder: { email?: string; firstName?: string }
  register: any
  handleSubmit: any
  errors: any
  interests: string[]
  onToggleInterest: (interest: string) => void
  onSubmit: (data: EmailCaptureData) => void
  isSubmitting: boolean
  showInterests: boolean
  variant: string
}> = ({
  title,
  description,
  benefits,
  primaryPiano,
  incentive,
  placeholder,
  register,
  handleSubmit,
  errors,
  interests,
  onToggleInterest,
  onSubmit,
  isSubmitting,
  showInterests,
  variant
}) => {
  const isCompact = variant === 'floating' || variant === 'modal'

  return (
    <motion.div
      initial={{ opacity: 0, y: 20 }}
      animate={{ opacity: 1, y: 0 }}
      exit={{ opacity: 0, y: -20 }}
      className="space-y-6"
    >
      {/* Header */}
      <div className="text-center space-y-3">
        {!isCompact && (
          <div className="w-16 h-16 bg-gradient-to-r from-blue-600 to-purple-600 rounded-full mx-auto flex items-center justify-center">
            <svg className="w-8 h-8 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} 
                d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
        )}
        
        <h3 className={cn(
          "font-bold text-gray-900",
          isCompact ? "text-xl" : "text-2xl md:text-3xl"
        )}>
          {title}
        </h3>
        
        <p className={cn(
          "text-gray-600",
          isCompact ? "text-sm" : "text-base"
        )}>
          {description}
        </p>
      </div>

      {/* Incentive Banner */}
      {incentive && (
        <div className="bg-gradient-to-r from-green-50 to-blue-50 border border-green-200 rounded-xl p-4">
          <div className="text-center space-y-2">
            <div className="flex items-center justify-center space-x-2">
              <svg className="w-5 h-5 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} 
                  d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1" />
              </svg>
              <span className="font-semibold text-green-800">{incentive.title}</span>
              {incentive.value && (
                <span className="bg-green-100 text-green-700 px-2 py-1 rounded-full text-xs font-bold">
                  {incentive.value}
                </span>
              )}
            </div>
            <p className="text-sm text-green-700">{incentive.description}</p>
          </div>
        </div>
      )}

      {/* Primary Piano Highlight */}
      {primaryPiano && !isCompact && (
        <div className="bg-blue-50 rounded-xl p-4 border border-blue-200">
          <div className="flex items-center space-x-4">
            <div className="w-12 h-12 bg-blue-600 rounded-lg flex items-center justify-center flex-shrink-0">
              <svg className="w-6 h-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} 
                  d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12-3c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2z" />
              </svg>
            </div>
            
            <div className="flex-1">
              <h4 className="font-semibold text-blue-900">Your Perfect Match</h4>
              <p className="text-blue-700 text-sm">{primaryPiano.name} • {primaryPiano.matchScore}% compatibility</p>
              <p className="text-blue-600 text-xs mt-1">{primaryPiano.shortDescription}</p>
            </div>
          </div>
        </div>
      )}

      {/* Form */}
      <form onSubmit={handleSubmit(onSubmit)} className="space-y-4">
        {/* Name and Email */}
        <div className={cn(
          "grid gap-4",
          isCompact ? "grid-cols-1" : "grid-cols-1 md:grid-cols-2"
        )}>
          <div>
            <label className="block text-sm font-medium text-gray-700 mb-2">
              First Name *
            </label>
            <input
              {...register('firstName')}
              type="text"
              className={cn(
                "w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all",
                errors.firstName ? "border-red-300" : "border-gray-300"
              )}
              placeholder={placeholder.firstName}
            />
            {errors.firstName && (
              <p className="mt-1 text-sm text-red-600">{errors.firstName.message}</p>
            )}
          </div>
          
          <div>
            <label className="block text-sm font-medium text-gray-700 mb-2">
              Email Address *
            </label>
            <input
              {...register('email')}
              type="email"
              className={cn(
                "w-full px-4 py-3 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all",
                errors.email ? "border-red-300" : "border-gray-300"
              )}
              placeholder={placeholder.email}
            />
            {errors.email && (
              <p className="mt-1 text-sm text-red-600">{errors.email.message}</p>
            )}
          </div>
        </div>

        {/* Purchase Timeline */}
        {!isCompact && (
          <div>
            <label className="block text-sm font-medium text-gray-700 mb-3">
              When are you looking to make a decision?
            </label>
            <div className="grid grid-cols-1 md:grid-cols-3 gap-3">
              {[
                { value: 'immediate', label: 'Within 30 days', badge: 'Hot Lead' },
                { value: 'soon', label: '2-6 months', badge: 'Active' },
                { value: 'exploring', label: 'Just exploring', badge: 'Research' }
              ].map(({ value, label, badge }) => (
                <label key={value} className="relative cursor-pointer">
                  <input
                    {...register('urgency')}
                    type="radio"
                    value={value}
                    className="sr-only"
                  />
                  <div className="p-3 border-2 border-gray-200 rounded-lg hover:border-blue-300 transition-colors peer-checked:border-blue-600 peer-checked:bg-blue-50 text-center">
                    <div className="font-medium text-gray-900 text-sm">{label}</div>
                    <div className="text-xs text-gray-500 mt-1">{badge}</div>
                  </div>
                </label>
              ))}
            </div>
          </div>
        )}

        {/* Interests Selection */}
        {showInterests && !isCompact && (
          <div>
            <label className="block text-sm font-medium text-gray-700 mb-3">
              Areas of Interest (optional)
            </label>
            <div className="flex flex-wrap gap-2">
              {[
                'Digital Pianos',
                'Grand Pianos',
                'Hybrid Technology',
                'Silent Systems',
                'Financing Options',
                'Trade-In Programs'
              ].map((interest) => (
                <button
                  key={interest}
                  type="button"
                  onClick={() => onToggleInterest(interest)}
                  className={cn(
                    "px-3 py-2 rounded-full text-sm font-medium transition-colors",
                    interests.includes(interest)
                      ? "bg-blue-600 text-white"
                      : "bg-gray-100 text-gray-700 hover:bg-gray-200"
                  )}
                >
                  {interest}
                </button>
              ))}
            </div>
          </div>
        )}

        {/* Marketing Opt-in */}
        <div className="flex items-start space-x-3">
          <input
            {...register('optInMarketing')}
            type="checkbox"
            className="w-5 h-5 text-blue-600 border-gray-300 rounded focus:ring-blue-500 mt-0.5"
          />
          <label className="text-sm text-gray-600 leading-relaxed">
            <span className="font-medium">Yes, send me exclusive piano insights!</span>
            {!isCompact && (
              <>
                {" "}I'd like to receive new arrival notifications, special offers, and expert piano guidance. 
                Unsubscribe anytime, and we never share your information.
              </>
            )}
          </label>
        </div>

        {/* Submit Button */}
        <button
          type="submit"
          disabled={isSubmitting}
          className={cn(
            "w-full py-4 bg-gradient-to-r from-blue-600 to-purple-600 hover:from-blue-700 hover:to-purple-700 text-white rounded-lg font-semibold transition-all shadow-lg hover:shadow-xl transform hover:-translate-y-0.5",
            isSubmitting && "opacity-50 cursor-not-allowed transform-none"
          )}
        >
          {isSubmitting ? (
            <div className="flex items-center justify-center space-x-2">
              <div className="w-5 h-5 border-2 border-white border-t-transparent rounded-full animate-spin" />
              <span>Sending Your Selection...</span>
            </div>
          ) : (
            <div className="flex items-center justify-center space-x-2">
              <svg className="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} 
                  d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
              <span>Send My Curated Selection</span>
            </div>
          )}
        </button>
      </form>

      {/* Benefits List */}
      {benefits.length > 0 && showBenefits && !isCompact && (
        <div className="bg-gray-50 rounded-xl p-4">
          <h4 className="text-sm font-semibold text-gray-900 mb-3 text-center">
            What You'll Receive:
          </h4>
          <ul className="grid grid-cols-1 md:grid-cols-2 gap-2">
            {benefits.map((benefit, index) => (
              <li key={index} className="flex items-center space-x-2 text-sm text-gray-700">
                <svg className="w-4 h-4 text-green-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M5 13l4 4L19 7" />
                </svg>
                <span>{benefit}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      {/* Privacy Notice */}
      <div className="text-xs text-gray-500 text-center">
        <div className="flex items-center justify-center space-x-1 mb-1">
          <svg className="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} 
              d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
          <span className="font-medium">Privacy Protected</span>
        </div>
        <p>Your information is secure and will only be used to provide your piano recommendations.</p>
      </div>
    </motion.div>
  )
}

/**
 * Success State Component
 */
const SuccessState: React.FC<{
  message: string
  variant: string
}> = ({ message, variant }) => {
  const isCompact = variant === 'floating' || variant === 'modal'

  return (
    <motion.div
      initial={{ opacity: 0, scale: 0.95 }}
      animate={{ opacity: 1, scale: 1 }}
      exit={{ opacity: 0, scale: 0.95 }}
      className="text-center space-y-4"
    >
      <div className={cn(
        "bg-green-100 rounded-full mx-auto flex items-center justify-center",
        isCompact ? "w-12 h-12" : "w-16 h-16"
      )}>
        <svg className={cn(
          "text-green-600",
          isCompact ? "w-6 h-6" : "w-8 h-8"
        )} fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M5 13l4 4L19 7" />
        </svg>
      </div>
      
      <div className="space-y-2">
        <h3 className={cn(
          "font-bold text-gray-900",
          isCompact ? "text-lg" : "text-2xl"
        )}>
          Success!
        </h3>
        <p className={cn(
          "text-gray-600",
          isCompact ? "text-sm" : "text-base"
        )}>
          {message}
        </p>
      </div>

      {!isCompact && (
        <div className="bg-blue-50 rounded-lg p-4 text-sm text-blue-800">
          <div className="flex items-center space-x-2">
            <svg className="w-4 h-4 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} 
                d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span className="font-medium">What's Next?</span>
          </div>
          <p className="mt-2">
            Check your inbox in the next few minutes. If you don't see our email, 
            please check your spam folder and add us to your contacts.
          </p>
        </div>
      )}
    </motion.div>
  )
}

/**
 * Error State Component
 */
const ErrorState: React.FC<{
  message: string
  onRetry: () => void
  variant: string
}> = ({ message, onRetry, variant }) => {
  const isCompact = variant === 'floating' || variant === 'modal'

  return (
    <motion.div
      initial={{ opacity: 0, scale: 0.95 }}
      animate={{ opacity: 1, scale: 1 }}
      exit={{ opacity: 0, scale: 0.95 }}
      className="text-center space-y-4"
    >
      <div className={cn(
        "bg-red-100 rounded-full mx-auto flex items-center justify-center",
        isCompact ? "w-12 h-12" : "w-16 h-16"
      )}>
        <svg className={cn(
          "text-red-600",
          isCompact ? "w-6 h-6" : "w-8 h-8"
        )} fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" />
        </svg>
      </div>
      
      <div className="space-y-2">
        <h3 className={cn(
          "font-bold text-gray-900",
          isCompact ? "text-lg" : "text-2xl"
        )}>
          Oops, something went wrong
        </h3>
        <p className={cn(
          "text-gray-600",
          isCompact ? "text-sm" : "text-base"
        )}>
          {message}
        </p>
      </div>

      <button
        onClick={onRetry}
        className="px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-semibold transition-all"
      >
        Try Again
      </button>
    </motion.div>
  )
}

export default EmailCapture