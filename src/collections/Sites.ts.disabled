  hooks: {
    beforeChange: [
      ({ data }) => {
        // Auto-generate slug from name if not provided
        if (data.name && !data.slug) {
          data.slug = data.name
            .toLowerCase()
            .replace(/\s+/g, '-')
            .replace(/[^a-z0-9-]/g, '')
            .substring(0, 50)
        }

        // Ensure only one default site
        if (data.isDefault) {
          // This will be handled by a collection hook to unset other defaults
        }

        return data
      }
    ],
    afterChange: [
      // Ensure only one default site exists
      async ({ doc, req, operation }) => {
        if (doc.isDefault && operation === 'create' || (operation === 'update' && doc.isDefault)) {
          await req.payload.update({
            collection: 'sites',
            where: {
              and: [
                { id: { not_equals: doc.id } },
                { isDefault: { equals: true } }
              ]
            },
            data: {
              isDefault: false
            }
          })
        }
      }
    ]
  },

  // Custom endpoints for site resolution
  endpoints: [
    {
      path: '/by-domain/:domain',
      method: 'get',
      handler: async (req: any) => {
        const { domain } = req.params

        try {
          const siteResult = await req.payload.find({
            collection: 'sites',
            where: {
              or: [
                { domain: { equals: domain } },
                { subdomain: { equals: domain.split('.')[0] } },
                { 'alternativeDomains.domain': { equals: domain } }
              ]
            },
            limit: 1
          })

          if (siteResult.docs.length === 0) {
            return Response.json({ error: 'Site not found' }, { status: 404 })
          }

          return Response.json({
            success: true,
            site: siteResult.docs[0]
          })
        } catch (error) {
          return Response.json({ error: 'Internal server error' }, { status: 500 })
        }
      }
    },

    {
      path: '/default',
      method: 'get',
      handler: async (req: any) => {
        try {
          const defaultSite = await req.payload.find({
            collection: 'sites',
            where: { isDefault: { equals: true } },
            limit: 1
          })

          if (defaultSite.docs.length === 0) {
            // Fallback to first active site
            const firstSite = await req.payload.find({
              collection: 'sites',
              where: { status: { equals: 'active' } },
              limit: 1,
              sort: 'createdAt'
            })

            if (firstSite.docs.length === 0) {
              return Response.json({ error: 'No sites found' }, { status: 404 })
            }

            return Response.json({
              success: true,
              site: firstSite.docs[0]
            })
          }

          return Response.json({
            success: true,
            site: defaultSite.docs[0]
          })
        } catch (error) {
          return Response.json({ error: 'Internal server error' }, { status: 500 })
        }
      }
    }
  ]
}