  // Collection Hooks for Template Inheritance and Validation
  hooks: {
    beforeChange: [
      // Ensure only one page per type per site (except custom pages)
      async ({ data, operation, req }) => {
        if (data.pageType !== 'custom' && (operation === 'create' || (operation === 'update' && data.pageType))) {
          const existing = await req.payload.find({
            collection: 'site-pages',
            where: {
              and: [
                { site: { equals: data.site } },
                { pageType: { equals: data.pageType } },
                ...(operation === 'update' ? [{ id: { not_equals: data.id } }] : [])
              ]
            },
            limit: 1
          })

          if (existing.docs.length > 0) {
            throw new Error(`A ${data.pageType} page already exists for this site. Only one page of each type is allowed per site.`)
          }
        }

        return data
      },
      
      // Auto-populate template data when needed
      async ({ data, operation, req }) => {
        if (data.templateSettings?.useTemplate && data.templateSettings?.templateSource) {
          try {
            const template = await req.payload.findByID({
              collection: 'site-pages',
              id: data.templateSettings.templateSource,
              depth: 2
            })

            if (template) {
              // Merge template data with current data
              // Only apply fields that aren't being overridden
              const overrideFields = data.templateSettings.overrideFields?.map(field => field.fieldPath) || []
              
              if (!overrideFields.includes('heroContent') && template.heroContent) {
                data.heroContent = template.heroContent
              }
              
              if (!overrideFields.includes('pianoCategories') && template.pianoCategories) {
                data.pianoCategories = template.pianoCategories
              }
              
              if (!overrideFields.includes('featuredModelsSection') && template.featuredModelsSection) {
                data.featuredModelsSection = template.featuredModelsSection
                data.featuredModels = template.featuredModels
              }
              
              if (!overrideFields.includes('ctaSection') && template.ctaSection) {
                data.ctaSection = template.ctaSection
              }
              
              if (!overrideFields.includes('seo') && template.seo) {
                data.seo = template.seo
              }
            }
          } catch (error) {
            console.warn('Could not load template data:', error.message)
          }
        }

        return data
      }
    ]
  },

  // Custom API endpoints for frontend consumption
  endpoints: [
    {
      path: '/by-site/:siteSlug/:pageType',
      method: 'get',
      handler: async (req: any) => {
        const { siteSlug, pageType } = req.params

        try {
          // Find the site first
          const siteResult = await req.payload.find({
            collection: 'sites',
            where: { slug: { equals: siteSlug } },
            limit: 1
          })

          if (siteResult.docs.length === 0) {
            return Response.json({ error: 'Site not found' }, { status: 404 })
          }

          const site = siteResult.docs[0]

          // Find the specific page
          const pageResult = await req.payload.find({
            collection: 'site-pages',
            where: {
              and: [
                { site: { equals: site.id } },
                { pageType: { equals: pageType } },
                { status: { equals: 'published' } }
              ]
            },
            limit: 1,
            depth: 3 // Deep populate for media and relationships
          })

          if (pageResult.docs.length === 0) {
            return Response.json({ error: `${pageType} page not found for site` }, { status: 404 })
          }

          const page = pageResult.docs[0]

          return Response.json({
            success: true,
            data: {
              ...page,
              site: site // Include site information
            }
          })
        } catch (error) {
          console.error('Error fetching site page:', error)
          return Response.json({ error: 'Internal server error' }, { status: 500 })
        }
      }
    },

    // Get all pages for a site
    {
      path: '/by-site/:siteSlug',
      method: 'get',
      handler: async (req: any) => {
        const { siteSlug } = req.params
        const url = new URL(req.url)
        const status = url.searchParams.get('status') || 'published'

        try {
          const siteResult = await req.payload.find({
            collection: 'sites',
            where: { slug: { equals: siteSlug } },
            limit: 1
          })

          if (siteResult.docs.length === 0) {
            return Response.json({ error: 'Site not found' }, { status: 404 })
          }

          const site = siteResult.docs[0]

          const pagesResult = await req.payload.find({
            collection: 'site-pages',
            where: {
              and: [
                { site: { equals: site.id } },
                { status: { equals: status } }
              ]
            },
            depth: 2
          })

          return Response.json({
            success: true,
            site: site,
            pages: pagesResult.docs
          })
        } catch (error) {
          console.error('Error fetching site pages:', error)
          return Response.json({ error: 'Internal server error' }, { status: 500 })
        }
      }
    }
  ]
}