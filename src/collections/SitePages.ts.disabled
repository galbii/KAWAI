import type { CollectionConfig, Field } from 'payload'
import { 
  isDeveloper,
  isSuperAdmin,
  isGlobalAdmin,
  canAccessSiteData,
  canManageContentAtSites,
  isAdminLevel
} from '../lib/access-control'

export const SitePages: CollectionConfig = {
  slug: 'site-pages',
  labels: {
    singular: 'Site Page',
    plural: 'Site Pages',
  },
  admin: {
    group: 'SITES',
    defaultColumns: ['site', 'pageType', 'title', 'status', 'updatedAt'],
    useAsTitle: 'title',
    description: 'Manage site-specific pages including pianos, home, about, and contact pages with template inheritance',
    pagination: {
      defaultLimit: 20,
      limits: [10, 20, 50, 100],
    },
    listSearchableFields: ['title', 'pageType', 'site.name'],
  },
  access: {
    read: canAccessSiteData, // Users can only see pages from sites they have access to
    create: canManageContentAtSites, // Content managers can create pages
    update: canManageContentAtSites, // Content managers can update pages
    delete: ({ req: { user } }) => {
      if (isGlobalAdmin({ req: { user } })) return true
      
      // Only site admins can delete pages
      const adminSites = user?.siteRoles
        ?.filter(role => role.role === 'admin')
        ?.map(role => role.site) || []
      
      if (adminSites.length === 0) return false
      
      return {
        site: { in: adminSites }
      }
    },
    admin: isAdminLevel, // Admin-level users can access admin panel
  },
  fields: [
    // Core Configuration Fields
    {
      name: 'site',
      type: 'relationship',
      relationTo: 'sites',
      required: true,
      admin: {
        description: 'Site this page belongs to',
        position: 'sidebar'
      },
      // Filter to only show sites the user has access to
      filterOptions: ({ user }) => {
        if (isGlobalAdmin({ req: { user } })) return {}
        
        return {
          id: {
            in: user?.sites?.map(site => site.id || site) || []
          }
        }
      }
    },
    {
      name: 'pageType',
      type: 'select',
      required: true,
      options: [
        { label: 'Pianos Page', value: 'pianos' },
        { label: 'Home Page', value: 'home' },
        { label: 'About Page', value: 'about' },
        { label: 'Contact Page', value: 'contact' },
        { label: 'Services Page', value: 'services' },
        { label: 'Custom Page', value: 'custom' }
      ],
      admin: {
        description: 'Type of page - determines available fields and templates',
        position: 'sidebar'
      }
    },
    {
      name: 'title',
      type: 'text',
      required: true,
      admin: {
        description: 'Internal page title for admin reference'
      }
    },
    {
      name: 'status',
      type: 'select',
      defaultValue: 'draft',
      options: [
        { label: 'Draft', value: 'draft' },
        { label: 'Published', value: 'published' },
        { label: 'Archived', value: 'archived' }
